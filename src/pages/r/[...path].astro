---
import Base from "../../layouts/Base.astro";

// Handles reddit-style paths so a reddit URL works with the host swapped:
//   /r/{sub}/comments/{postId}[/{title}[/{commentId}]]
//   /r/{sub}/s/{code}  (share links)
// Share links need the visitor's credentials to resolve, which only the browser
// has, so the editor resolves them.
const [sub, kind, id, , commentId] = (Astro.params.path ?? "")
  .split("/")
  .filter(Boolean);

if (sub && kind === "comments" && id) {
  const params = new URLSearchParams({ sub, postId: id });
  if (commentId) {
    params.set("commentId", commentId);
  }
  return Astro.redirect(`/generate?${params}`, 308);
}

if (sub && kind === "s" && id) {
  return Astro.redirect(`/generate?${new URLSearchParams({ sub, share: id })}`, 308);
}

Astro.response.status = 404;
---

<Base title="Link not found | threadshot.app" noindex>
  <div class="mx-auto max-w-[1280px] px-4 py-16 lg:px-8">
    <h1 class="heading text-3xl">
      That does not look like a Reddit post or comment link.
    </h1>
    <p class="mt-4">
      <a href="/" class="link">Try another link</a>
    </p>
  </div>
</Base>
