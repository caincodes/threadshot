---
import Base from "../../layouts/Base.astro";
import { MissingCredentialsError } from "../../server/redditAuth";
import { resolveShareLink } from "../../server/resolveShare";

// Handles reddit-style paths so a reddit URL works with the host swapped:
//   /r/{sub}/comments/{postId}[/{title}[/{commentId}]]
//   /r/{sub}/s/{code}  (share links)
const [sub, kind, id, , commentId] = (Astro.params.path ?? "")
  .split("/")
  .filter(Boolean);

const redirectToEditor = (post: {
  sub: string;
  postId: string;
  commentId?: string | null;
}) => {
  const params = new URLSearchParams({ sub: post.sub, postId: post.postId });
  if (post.commentId) {
    params.set("commentId", post.commentId);
  }
  return Astro.redirect(`/generate?${params}`, 308);
};

let message = "That does not look like a Reddit post or comment link.";

if (sub && kind === "comments" && id) {
  return redirectToEditor({ sub, postId: id, commentId });
}

if (sub && kind === "s" && id) {
  try {
    const resolved = await resolveShareLink(sub, id);
    if (resolved) {
      return redirectToEditor(resolved);
    }
    message = "Could not resolve that Reddit share link.";
  } catch (error) {
    message =
      error instanceof MissingCredentialsError
        ? error.message
        : "Could not reach Reddit to resolve that share link.";
  }
}

Astro.response.status = 404;
---

<Base title="Link not found | threadshot">
  <div class="mx-auto max-w-[1280px] px-4 py-16 lg:px-8">
    <h1 class="font-display text-3xl font-extrabold tracking-[-0.02em]">
      {message}
    </h1>
    <p class="mt-4">
      <a href="/" class="link">Try another link</a>
    </p>
  </div>
</Base>
