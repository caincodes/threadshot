---
import Base from "../../../../layouts/Base.astro";

// An x.com or twitter.com link with the host swapped:
//   /{user}/status/{id}[/photo/1, /video/1, ...]
const { id = "" } = Astro.params;

if (/^\d{1,25}$/.test(id)) {
  return Astro.redirect(`/generate?${new URLSearchParams({ x: id })}`, 308);
}

Astro.response.status = 404;
---

<Base title="Link not found | Threadshot for Reddit and X" noindex>
  <div class="mx-auto max-w-[1280px] px-4 py-16 lg:px-8">
    <h1 class="heading text-3xl">That does not look like a link to a post on X.</h1>
    <p class="mt-4">
      <a href="/" class="link">Try another link</a>
    </p>
  </div>
</Base>
