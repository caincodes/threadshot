---
import ShareImage from "../components/thread/ShareImage.svelte";
import XShareImage from "../components/thread/x/XShareImage.svelte";
import Start from "../components/Start.svelte";
import { parseComments } from "../functions/util/parseComments";
import { parseSubmission } from "../functions/util/parseSubmission";
import { sampleRedditResponse } from "../lib/sampleThread";
import { sampleXPost } from "../lib/sampleXPost";
import Base from "../layouts/Base.astro";

// The hero shows the real renderer on a sample thread, not a mockup.
const [submissionListing, commentListing] = sampleRedditResponse();
const sample = {
  submission: parseSubmission(submissionListing.data.children[0].data, ""),
  comments: parseComments(commentListing.data.children, ""),
};
---

<Base
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "threadshot.app",
    url: new URL("/", Astro.site).href,
    description:
      "Turn any Reddit thread or post on X into a clean, phone-sized image.",
    applicationCategory: "MultimediaApplication",
    operatingSystem: "Any",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  }}
>
  <div
    class="mx-auto grid max-w-[1280px] gap-10 px-4 py-10 md:grid-cols-2 md:gap-12 md:py-16 lg:px-8"
  >
    <section class="flex min-w-0 flex-col">
      <p class="flex items-center gap-2 text-sm font-semibold text-ink-2">
        Built for
        <span class="platform-badge">X</span>
        <span aria-hidden="true">+</span>
        <span class="platform-badge">Reddit</span>
      </p>
      <h1
        class="heading mt-4 text-4xl leading-[1.02] text-pretty sm:text-5xl lg:text-6xl"
      >
        Turn Reddit threads and X posts into clean images
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-2">
        Send a thread from Reddit or paste a link to a post on X, then download
        it as an image that fits a phone screen. Or try a sample from{" "}
        <a class="link" href="/generate?sample=1">Reddit</a> or{" "}
        <a class="link" href="/generate?sample=x">X</a>.
      </p>

      <Start client:only="svelte" />
    </section>

    <div
      aria-hidden="true"
      class="max-h-[480px] overflow-hidden border border-line bg-canvas p-3 sm:max-h-[640px] sm:p-6 md:sticky md:top-6 md:max-h-[680px] md:self-start"
    >
      <div
        class="mx-auto w-fit [zoom:0.72] sm:[zoom:1] md:[zoom:0.75] lg:[zoom:1]"
      >
        <div data-preview="reddit">
          <ShareImage
            comments={sample.comments}
            submission={sample.submission}
          />
        </div>
        <div data-preview="x">
          <XShareImage post={sampleXPost()} />
        </div>
      </div>
    </div>
  </div>
</Base>

