---
import RedditThread from "../components/thread/RedditThread.svelte";
import { parseComments } from "../functions/util/parseComments";
import { parseSubmission } from "../functions/util/parseSubmission";
import Base from "../layouts/Base.astro";
import { mockRedditResponse } from "../server/mockReddit";

// The hero shows the real renderer on a sample thread, not a mockup.
const [submissionListing, commentListing] = mockRedditResponse();
const sample = {
  submission: parseSubmission(submissionListing.data.children[0].data, ""),
  comments: parseComments(commentListing.data.children, ""),
};
---

<Base>
  <div
    class="mx-auto grid max-w-[1280px] gap-10 px-4 py-10 md:grid-cols-2 md:gap-12 md:py-16 lg:px-8"
  >
    <section class="flex flex-col justify-center">
      <h1
        class="font-display text-4xl leading-[1.02] font-extrabold tracking-[-0.02em] sm:text-5xl lg:text-6xl"
      >
        Turn a Reddit thread into a clean image
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-2">
        Paste a post or comment link. Choose how many comments to keep, hide
        usernames if you need to, and download a PNG that looks like Reddit,
        in light or dark.
      </p>

      <form id="url-form" class="mt-8 flex flex-col gap-3" novalidate>
        <label for="url-input" class="text-sm font-semibold">
          Reddit post or comment link
        </label>
        <input
          id="url-input"
          type="text"
          inputmode="url"
          placeholder="https://www.reddit.com/r/woodworking/comments/..."
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          aria-describedby="url-error"
          class="field"
        />
        <p
          id="url-error"
          role="alert"
          class="min-h-5 text-sm font-medium text-accent"
        >
        </p>
        <button type="submit" class="btn btn-primary self-start">
          Generate screenshot
        </button>
      </form>

      <p class="mt-6 text-sm text-ink-2">
        Full links and the share links from the Reddit app both work.
      </p>
    </section>

    <div
      aria-hidden="true"
      class="h-[440px] overflow-hidden border border-line bg-canvas p-3 sm:h-[600px] sm:p-6 md:h-auto md:max-h-[640px]"
    >
      <div
        class="w-fit [zoom:0.46] sm:[zoom:0.8] md:[zoom:0.48] lg:[zoom:0.62] xl:[zoom:0.78]"
      >
        <RedditThread
          comments={sample.comments}
          submission={sample.submission}
        />
      </div>
    </div>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>("#url-form")!;
  const input = document.querySelector<HTMLInputElement>("#url-input")!;
  const error = document.querySelector<HTMLElement>("#url-error")!;

  const POST_PATH = /^\/r\/[\w-]+\/(comments\/\w+|s\/[\w-]+)(\/|$)/;

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    error.textContent = "";
    const value = input.value.trim();
    if (!value) {
      error.textContent = "Paste a Reddit link first.";
      return;
    }
    try {
      const { pathname } = new URL(value);
      if (!POST_PATH.test(pathname)) {
        throw new Error();
      }
      window.location.href = pathname;
    } catch {
      error.textContent =
        "That does not look like a Reddit post or comment link.";
    }
  });
</script>
