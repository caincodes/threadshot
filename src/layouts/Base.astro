---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "threadshot.app: Reddit threads as clean images",
  description = "Paste a Reddit post or comment link and download a PNG that looks like Reddit.",
} = Astro.props;

// The old *.vercel.app address still serves the site (bookmarks made there
// keep working), so every page names threadshot.app as the real address.
const canonical = new URL(Astro.url.pathname, Astro.site);

const REPOSITORY = "https://github.com/caincodes/threadshot";
const deployedAt = new Intl.DateTimeFormat("en-US", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "UTC",
}).format(new Date(__BUILD_TIME__));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/logo192.png" />
    <link rel="manifest" href="/manifest.json" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-b border-line">
      <div class="mx-auto flex h-14 max-w-[1280px] items-center px-4 lg:px-8">
        <a
          href="/"
          class="font-display text-xl font-extrabold tracking-[-0.02em]"
        >
          threadshot.app
        </a>
      </div>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-line">
      <div
        class="mx-auto flex max-w-[1280px] flex-col gap-2 px-4 py-5 text-sm text-ink-2 lg:px-8"
      >
        <p>
          threadshot.app is not affiliated with Reddit. Posts and comments belong
          to their authors.
        </p>
        <p class="flex flex-wrap gap-x-4 gap-y-1">
          <a class="link" href={REPOSITORY} rel="noopener">GitHub</a>
          {
            __BUILD_COMMIT__ && (
              <span>
                Version{" "}
                <a
                  class="link font-mono"
                  href={`${REPOSITORY}/commit/${__BUILD_COMMIT__}`}
                  rel="noopener"
                >
                  {__BUILD_COMMIT__.slice(0, 7)}
                </a>
              </span>
            )
          }
          <span>
            Deployed <time datetime={__BUILD_TIME__}>{deployedAt} UTC</time>
          </span>
        </p>
      </div>
    </footer>
  </body>
</html>
