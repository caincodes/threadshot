---
import { Icon } from "astro-iconify";

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  // Path or URL of the social preview image (1200x630).
  image?: string;
  imageAlt?: string;
  // Keeps a page out of search results, for tool pages with no content of their own.
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const SITE_NAME = "threadshot.app";

const {
  title = "threadshot.app: Reddit threads as clean images",
  description = "Turn any Reddit post or comment into a clean, phone-sized image. Choose what to show, hide usernames, then download or share it. Free, no account.",
  image = "/og.png",
  imageAlt = "A Reddit post and its replies as a clean image made with threadshot.app",
  noindex = false,
  jsonLd,
} = Astro.props;

// The old *.vercel.app address still serves the site (bookmarks made there
// keep working), so every page names threadshot.app as the real address.
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

const REPOSITORY = "https://github.com/caincodes/threadshot";
// "2026-10-31T19:05:12.000Z" becomes "2026/10/31, 19:05".
const releasedAt = __BUILD_TIME__.slice(0, 16)
  .replaceAll("-", "/")
  .replace("T", ", ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <meta name="application-name" content={SITE_NAME} />
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-b border-line">
      <div
        class="mx-auto flex h-14 max-w-[1280px] items-center justify-between px-4 lg:px-8"
      >
        <a
          href="/"
          class="heading text-xl"
        >
          threadshot.app
        </a>
        <nav class="-mr-2.5 flex items-center gap-1">
          <a
            class="nav-link"
            href={`${REPOSITORY}/issues/new`}
            rel="noopener"
            title="Suggestions or issues"
          >
            Feedback
          </a>
          <a
            class="nav-link"
            aria-label="threadshot.app on GitHub"
            href={REPOSITORY}
            rel="noopener"
          >
            <Icon class="size-6" name="github" optimize={false} />
          </a>
        </nav>
      </div>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-line">
      <div
        class="mx-auto flex max-w-[1280px] flex-col gap-3 px-4 py-5 text-sm text-ink-2 sm:flex-row sm:justify-between sm:gap-8 lg:px-8"
      >
        <p>
          <strong class="font-semibold text-ink">threadshot.app</strong> is not
          affiliated with Reddit. Posts and comments belong
          to their authors.
        </p>
        <p
          class="flex flex-col gap-y-1 tabular-nums sm:shrink-0 sm:items-end lg:flex-row lg:gap-x-4"
        >
          {
            __BUILD_COMMIT__ && (
              <span>
                {__BUILD_VERSION__ && (
                  <strong class="font-semibold text-ink">
                    v{__BUILD_VERSION__}
                  </strong>
                )}{" "}
                <span class="font-mono text-xs">
                  ({__BUILD_COMMIT__.slice(0, 7)})
                </span>
              </span>
            )
          }
          <span class="lg:border-l lg:border-line lg:pl-4">
            Released <time datetime={__BUILD_TIME__}>{releasedAt} UTC</time>
          </span>
        </p>
      </div>
    </footer>
  </body>
</html>
